# Copy this file to ".env" on the server and fill in real values. Never commit the real .env.

# ── SQL Server SA password ──────────────────────────────────────────────
# Must satisfy SQL Server complexity (upper + lower + digit, 8+ chars). No spaces.
SA_PASSWORD=Change_This_Str0ngPass

# ── JWT signing key ─────────────────────────────────────────────────────
# A long random string, 48+ chars. Generate with:  openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-secret

# ── Your free DuckDNS domain ────────────────────────────────────────────
# Register at https://www.duckdns.org (sign in, pick a subdomain), then point it at this
# server's public IP. Put the full hostname here (no https://, no trailing slash).
DOMAIN=yourfarm.duckdns.org
