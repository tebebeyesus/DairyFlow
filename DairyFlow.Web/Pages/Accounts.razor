@page "/accounts"
@inject HttpClient Http
@inject AppState State
@implements IDisposable

<PageTitle>@L["nav.accounts"] — DairyFlow</PageTitle>

<div class="page-header">
    <div class="page-title">💼 @L["acct.title"]</div>
    <button class="btn btn-primary" @onclick="OpenAdd">@L["acct.add"]</button>
</div>

@* ── Summary chips ── *@
<div class="filter-bar">
    <span class="feedlog-metric"><span class="feedlog-metric-label">@L["acct.active"]</span><span class="feedlog-metric-value">@activeCount</span></span>
    <span class="feedlog-metric"><span class="feedlog-metric-label">@L["acct.daily_income"]</span><span class="feedlog-metric-value">@totalDaily.ToString("N0")</span></span>
    <span class="feedlog-metric"><span class="feedlog-metric-label">@L["acct.month_income"]</span><span class="feedlog-metric-value">@totalMonth.ToString("N0")</span></span>
    <label style="margin-left:auto;display:flex;align-items:center;gap:6px;font-size:13px;color:var(--text-muted)">
        <input type="checkbox" checked="@activeOnly" @onchange="OnActiveOnlyChanged" /> @L["acct.activeonly"]
    </label>
</div>

@* ── Account add/edit modal ── *@
@if (showForm)
{
    <div class="modal-overlay" @onclick="() => showForm = false">
        <div class="modal" @onclick:stopPropagation style="max-width:560px">
            <h3>@(editingId == null ? L["acct.addtitle"] : L["acct.edittitle"])</h3>
            <div class="form-group">
                <label class="form-label">@L["acct.company"] *</label>
                <input class="form-control" @bind="form.CompanyName" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">@L["acct.owner"]</label>
                    <input class="form-control" @bind="form.OwnerName" />
                </div>
                <div class="form-group">
                    <label class="form-label">@L["acct.phone"]</label>
                    <input class="form-control" @bind="form.Phone" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">@L["acct.liters_day"] *</label>
                    <input type="number" step="0.1" min="0" class="form-control" @bind="form.ExpectedLitersPerDay" />
                </div>
                @if (editingId == null)
                {
                    <div class="form-group">
                        <label class="form-label">@L["acct.price"] *</label>
                        <input type="number" step="0.01" min="0" class="form-control" @bind="form.PricePerLiter" />
                    </div>
                }
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">@L["acct.start"] *</label>
                    <input type="date" class="form-control" value="@form.StartDate" @onchange="e => form.StartDate = e.Value?.ToString() ?? form.StartDate" />
                </div>
                <div class="form-group">
                    <label class="form-label">@L["acct.end"] <span style="text-transform:none;font-weight:400">(@L["feed.optional"])</span></label>
                    <input type="date" class="form-control" value="@form.EndDate" @onchange="e => form.EndDate = e.Value?.ToString()" />
                </div>
            </div>
            @if (editingId == null)
            {
                <div class="form-group">
                    <label class="form-label">@L["acct.daily_est"]: <strong>@((form.ExpectedLitersPerDay * form.PricePerLiter).ToString("N2")) ETB</strong></label>
                </div>
            }
            <div class="form-group">
                <label class="form-label">@L["lbl.notes"]</label>
                <input class="form-control" @bind="form.Notes" />
            </div>
            @if (!string.IsNullOrEmpty(formError)) { <div class="alert alert-danger">@formError</div> }
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showForm = false">@L["btn.cancel"]</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@saving">@(saving ? L["btn.saving"] : L["btn.save"])</button>
            </div>
        </div>
    </div>
}

@* ── Change-price modal ── *@
@if (showPriceForm)
{
    <div class="modal-overlay" @onclick="() => showPriceForm = false">
        <div class="modal" @onclick:stopPropagation style="max-width:440px">
            <h3>@L["acct.changeprice"]</h3>
            <p style="font-size:13px;color:var(--text-muted);margin-top:-4px">@priceFormCompany</p>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">@L["acct.newprice"] *</label>
                    <input type="number" step="0.01" min="0" class="form-control" @bind="priceForm.PricePerLiter" />
                </div>
                <div class="form-group">
                    <label class="form-label">@L["acct.effective"] *</label>
                    <input type="date" class="form-control" value="@priceForm.EffectiveFrom" @onchange="e => priceForm.EffectiveFrom = e.Value?.ToString() ?? priceForm.EffectiveFrom" />
                </div>
            </div>
            <div class="alert alert-info" style="font-size:12px">@L["acct.price_hint"]</div>
            @if (!string.IsNullOrEmpty(priceError)) { <div class="alert alert-danger">@priceError</div> }
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showPriceForm = false">@L["btn.cancel"]</button>
                <button class="btn btn-primary" @onclick="SavePriceAsync" disabled="@saving">@(saving ? L["btn.saving"] : L["btn.save"])</button>
            </div>
        </div>
    </div>
}

@if (loading) { <div class="loading-spinner">@L["btn.saving"]</div> }
else
{
    <div class="data-table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>@L["acct.company"]</th>
                    <th>@L["acct.liters_day"]</th>
                    <th>@L["acct.price"]</th>
                    <th>@L["acct.daily"]</th>
                    <th>@L["acct.month"]</th>
                    <th>@L["acct.total"]</th>
                    <th>@L["lbl.status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in accounts)
                {
                    var id        = Str(a, "id");
                    var company   = Str(a, "companyName");
                    var owner     = Str(a, "ownerName");
                    var liters    = Dec(a, "expectedLitersPerDay");
                    var price     = Dec(a, "currentPrice");
                    var daily     = Dec(a, "dailyAmount");
                    var month     = Dec(a, "monthBilled");
                    var total     = Dec(a, "totalBilled");
                    var isActive  = a.TryGetProperty("isActive", out var ia) && ia.GetBoolean();
                    var expanded  = expandedIds.Contains(id);

                    <tr class="md-parent @(expanded ? "is-open" : "")" @onclick="() => Toggle(id)">
                        <td>
                            <span class="md-caret">@(expanded ? "▾" : "▸")</span>
                            <strong>@company</strong>
                            @if (!string.IsNullOrEmpty(owner)) { <span style="color:var(--text-muted);font-size:12px"> · @owner</span> }
                        </td>
                        <td>@liters.ToString("F1") L</td>
                        <td>@price.ToString("F2")</td>
                        <td><strong>@daily.ToString("N0")</strong></td>
                        <td>@month.ToString("N0")</td>
                        <td><strong>@total.ToString("N0")</strong></td>
                        <td>
                            @if (isActive) { <span class="badge badge-green">@L["acct.s.active"]</span> }
                            else { <span class="badge badge-gray">@L["acct.s.ended"]</span> }
                        </td>
                        <td style="white-space:nowrap">
                            <button class="btn btn-sm btn-outline" @onclick="() => OpenPrice(a)" @onclick:stopPropagation>@L["acct.price_btn"]</button>
                            <button class="btn btn-sm btn-outline" @onclick="() => OpenEdit(a)" @onclick:stopPropagation>@L["btn.edit"]</button>
                        </td>
                    </tr>

                    @if (expanded)
                    {
                        <tr class="md-child-head">
                            <td style="padding-left:34px">@L["acct.history"]</td>
                            <td>@L["acct.effective"]</td>
                            <td colspan="6">@L["acct.price"]</td>
                        </tr>
                        @if (a.TryGetProperty("prices", out var prices) && prices.ValueKind == System.Text.Json.JsonValueKind.Array)
                        {
                            @foreach (var p in prices.EnumerateArray().Reverse())
                            {
                                var pf = p.TryGetProperty("effectiveFrom", out var ef) ? ef.GetString() : "";
                                var pp = p.TryGetProperty("pricePerLiter", out var pv) ? pv.GetDecimal() : 0;
                                <tr class="md-child">
                                    <td style="padding-left:34px;color:var(--text-muted)">@L["acct.from"]</td>
                                    <td>@pf</td>
                                    <td colspan="6">@pp.ToString("F2") ETB / L</td>
                                </tr>
                            }
                        }
                        <tr class="md-child">
                            <td style="padding-left:34px" colspan="8">
                                <span style="color:var(--text-muted);font-size:12px">@L["acct.start"]: @Str(a, "startDate")@if (!string.IsNullOrEmpty(Str(a, "endDate"))) { <text> · @L["acct.end"]: @Str(a, "endDate")</text>} · @Int(a, "activeDays") @L["acct.days"]</span>
                                <button class="btn btn-sm btn-outline" style="float:right" @onclick="() => DeleteAsync(id, company)" @onclick:stopPropagation>@L["acct.delete"]</button>
                            </td>
                        </tr>
                    }
                }
                @if (!accounts.Any()) { <tr><td colspan="8" class="empty-row">@L["acct.empty"]</td></tr> }
            </tbody>
        </table>
    </div>
}

@code {
    List<System.Text.Json.JsonElement> accounts = new();
    bool loading, showForm, showPriceForm, saving, activeOnly;
    string formError = "", priceError = "", priceFormCompany = "";
    string? editingId, pricingId;
    HashSet<string> expandedIds = new();

    AccountForm form = new();
    PriceForm priceForm = new();

    int activeCount;
    decimal totalDaily, totalMonth;

    protected override void OnInitialized() => State.OnChange += StateHasChanged;
    public void Dispose() => State.OnChange -= StateHasChanged;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        loading = true;
        try
        {
            accounts = await Http.GetFromJsonAsync<List<System.Text.Json.JsonElement>>($"/api/accounts?activeOnly={activeOnly.ToString().ToLower()}") ?? new();
            activeCount = accounts.Count(a => a.TryGetProperty("isActive", out var ia) && ia.GetBoolean());
            totalDaily  = accounts.Where(a => a.TryGetProperty("isActive", out var ia) && ia.GetBoolean()).Sum(a => Dec(a, "dailyAmount"));
            totalMonth  = accounts.Sum(a => Dec(a, "monthBilled"));
        }
        catch { }
        finally { loading = false; }
    }

    async Task OnActiveOnlyChanged(ChangeEventArgs e)
    {
        activeOnly = (bool?)e.Value ?? false;
        await LoadAsync();
    }

    void Toggle(string id) { if (!expandedIds.Remove(id)) expandedIds.Add(id); }

    void OpenAdd()
    {
        editingId = null;
        form = new AccountForm { StartDate = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd") };
        formError = "";
        showForm = true;
    }

    void OpenEdit(System.Text.Json.JsonElement a)
    {
        editingId = Str(a, "id");
        form = new AccountForm
        {
            CompanyName = Str(a, "companyName"),
            OwnerName = Str(a, "ownerName"),
            Phone = Str(a, "phone"),
            ExpectedLitersPerDay = Dec(a, "expectedLitersPerDay"),
            StartDate = Str(a, "startDate"),
            EndDate = Str(a, "endDate"),
            Notes = Str(a, "notes"),
        };
        formError = "";
        showForm = true;
    }

    async Task SaveAsync()
    {
        formError = "";
        if (string.IsNullOrWhiteSpace(form.CompanyName)) { formError = L["acct.err.company"]; return; }
        if (form.ExpectedLitersPerDay <= 0) { formError = L["acct.err.liters"]; return; }
        if (!DateOnly.TryParseExact(form.StartDate, "yyyy-MM-dd", out var start)) { formError = L["feedlog.err.date"]; return; }
        DateOnly? end = DateOnly.TryParseExact(form.EndDate, "yyyy-MM-dd", out var ed) ? ed : null;

        saving = true;
        try
        {
            System.Net.Http.HttpResponseMessage resp;
            if (editingId == null)
            {
                if (form.PricePerLiter <= 0) { formError = L["acct.err.price"]; saving = false; return; }
                var payload = new
                {
                    form.CompanyName, form.OwnerName, form.Phone, form.ExpectedLitersPerDay,
                    startDate = start.ToString("yyyy-MM-dd"),
                    endDate = end?.ToString("yyyy-MM-dd"),
                    form.PricePerLiter, form.Notes
                };
                resp = await Http.PostAsJsonAsync("/api/accounts", payload);
            }
            else
            {
                var payload = new
                {
                    form.CompanyName, form.OwnerName, form.Phone, form.ExpectedLitersPerDay,
                    startDate = start.ToString("yyyy-MM-dd"),
                    endDate = end?.ToString("yyyy-MM-dd"),
                    form.Notes
                };
                resp = await Http.PutAsJsonAsync($"/api/accounts/{editingId}", payload);
            }

            if (resp.IsSuccessStatusCode) { showForm = false; await LoadAsync(); }
            else { formError = $"{L["err.savefail"]} ({(int)resp.StatusCode})"; }
        }
        catch (Exception ex) { formError = $"{L["err.savefail"]}: {ex.Message}"; }
        finally { saving = false; }
    }

    void OpenPrice(System.Text.Json.JsonElement a)
    {
        pricingId = Str(a, "id");
        priceFormCompany = Str(a, "companyName");
        priceForm = new PriceForm { EffectiveFrom = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd"), PricePerLiter = Dec(a, "currentPrice") };
        priceError = "";
        showPriceForm = true;
    }

    async Task SavePriceAsync()
    {
        priceError = "";
        if (priceForm.PricePerLiter <= 0) { priceError = L["acct.err.price"]; return; }
        if (!DateOnly.TryParseExact(priceForm.EffectiveFrom, "yyyy-MM-dd", out var eff)) { priceError = L["feedlog.err.date"]; return; }

        saving = true;
        try
        {
            var payload = new { priceForm.PricePerLiter, effectiveFrom = eff.ToString("yyyy-MM-dd") };
            var resp = await Http.PostAsJsonAsync($"/api/accounts/{pricingId}/price", payload);
            if (resp.IsSuccessStatusCode) { showPriceForm = false; await LoadAsync(); }
            else { priceError = $"{L["err.savefail"]} ({(int)resp.StatusCode})"; }
        }
        catch (Exception ex) { priceError = $"{L["err.savefail"]}: {ex.Message}"; }
        finally { saving = false; }
    }

    async Task DeleteAsync(string id, string company)
    {
        var resp = await Http.DeleteAsync($"/api/accounts/{id}");
        if (resp.IsSuccessStatusCode) await LoadAsync();
    }

    // ── JSON helpers ──
    static string Str(System.Text.Json.JsonElement e, string k)
        => e.TryGetProperty(k, out var v) && v.ValueKind != System.Text.Json.JsonValueKind.Null ? (v.GetString() ?? "") : "";
    static decimal Dec(System.Text.Json.JsonElement e, string k)
        => e.TryGetProperty(k, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.Number ? v.GetDecimal() : 0;
    static int Int(System.Text.Json.JsonElement e, string k)
        => e.TryGetProperty(k, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.Number ? v.GetInt32() : 0;

    class AccountForm
    {
        public string CompanyName { get; set; } = "";
        public string? OwnerName { get; set; }
        public string? Phone { get; set; }
        public decimal ExpectedLitersPerDay { get; set; }
        public string StartDate { get; set; } = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
        public string? EndDate { get; set; }
        public decimal PricePerLiter { get; set; }
        public string? Notes { get; set; }
    }

    class PriceForm
    {
        public decimal PricePerLiter { get; set; }
        public string EffectiveFrom { get; set; } = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    }
}
